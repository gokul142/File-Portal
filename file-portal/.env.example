SECRET_KEY=change-me

# --- Local mode (default): embedded moto server emulates S3 + DynamoDB ---
USE_LOCAL_AWS=true
LOCAL_AWS_HOST=127.0.0.1
LOCAL_AWS_PORT=5001

# --- Real AWS: set USE_LOCAL_AWS=false and provide real credentials ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy-access-key
AWS_SECRET_ACCESS_KEY=dummy-secret-key
S3_BUCKET=file-portal-uploads
DYNAMODB_TABLE=file-portal-files
# AWS_ENDPOINT_URL=http://localhost:4566   # e.g. LocalStack

DEFAULT_EXPIRY_MINUTES=10
MIN_EXPIRY_MINUTES=1
MAX_EXPIRY_MINUTES=1440
PRESIGNED_URL_SECONDS=60
MAX_UPLOAD_MB=50

HOST=127.0.0.1
PORT=5000
